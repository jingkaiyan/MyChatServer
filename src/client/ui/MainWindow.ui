  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background: #0b1220;
}
QWidget#centralwidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #0f172a, stop:1 #111827);
}
QFrame#chatCard {
    background: rgba(17, 24, 39, 210);
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 16px;
}
QFrame#sideCard {
    background: rgba(17, 24, 39, 190);
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 16px;
}
QLabel#titleLabel {
    color: #f8fafc;
    font-size: 22px;
    font-weight: 700;
}
QLabel#subtitleLabel {
    color: #94a3b8;
    font-size: 13px;
}
QLabel#currentChatLabel {
    color: #cbd5e1;
    font-size: 13px;
    font-weight: 600;
}
QTextBrowser {
    color: #e2e8f0;
    background: rgba(2, 6, 23, 0.65);
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 12px;
    padding: 10px;
    font-size: 13px;
}
QLineEdit {
    color: #f1f5f9;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(148, 163, 184, 0.35);
    border-radius: 11px;
    padding: 9px 12px;
    font-size: 13px;
}
QLineEdit:focus {
    border: 1px solid #60a5fa;
}
QTabWidget::pane {
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 10px;
    background: rgba(2, 6, 23, 0.45);
}
QTabBar::tab {
    color: #94a3b8;
    padding: 7px 14px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}
QTabBar::tab:selected {
    color: #e2e8f0;
    background: rgba(37, 99, 235, 0.25);
}
QListWidget {
    color: #e2e8f0;
    background: transparent;
    border: none;
    outline: none;
}
QListWidget::item {
    border-radius: 8px;
    padding: 8px;
    margin: 2px;
}
QListWidget::item:selected {
    background: rgba(37, 99, 235, 0.35);
}
QLabel#contactStatsLabel {
    color: #94a3b8;
    font-size: 12px;
}
QPushButton#sendButton {
    color: #ffffff;
    background: #2563eb;
    border: none;
    border-radius: 11px;
    min-width: 110px;
    min-height: 40px;
    font-size: 14px;
    font-weight: 700;
}
QPushButton#sendButton:hover { background: #3b82f6; }
QPushButton#sendButton:pressed { background: #1d4ed8; }</string>
